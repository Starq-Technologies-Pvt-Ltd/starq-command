# Dependencies (also covered by the workspace-root .gitignore)
node_modules/

# Build artifacts — regenerated by `npm run build`, never source.
# Repo convention: zero dist/ or tsbuildinfo files are committed anywhere in
# this repository. These are outputs, and a committed bundle goes stale the
# moment source changes, which is worse than no bundle in history.
dist/
*.tsbuildinfo

# Local environment overrides
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Command lifecycle state and child logs.
.command-runtime/

# Local control-plane runtime databases
data/*.db*

# Added for the single-authoritative-repo consolidation (Founder #11859 / Room #11862):

# Additional build outputs beyond dist/
dist-observation/
dist-observation-hardening-*/

# Command runtime observation state (sibling of .command-runtime/)
.command-runtime-observation/

# Nested agent-comms placeholder — the canonical comms root is D:\StarqTech\agent-comms,
# not a copy inside this product directory.
/agent-comms/

# Generated/empty local cache
cache/

# Pre-10 Oct baseline snapshot files — generated at a point in time, not source.
.baseline-extension-*.json
.source-baseline-*.json

# Live board snapshots (generated); the board/*.json state files themselves stay tracked.
board/snapshots/

# Evidence/audit-trail artifacts (test logs, hashes, generated reports) — operationally
# valuable but not source; kept on disk, not version-controlled.
evidence/

# Takeover preservation (2026-10-27)
.git.unborn-backup-*/
nul
oct/
observation/
continuity/
continuity-support/
*.zip
._*

scripts/.command-runtime-test/

# Recovered Nexus assets (23,509 files / 1.63 GB), Founder authorization 2026-10-28.
# These are READ AT RUNTIME by server/nexus-library.mjs (library root) and
# server/nexus-cortex.mjs (graph.json), so the tree must stay in place on disk.
# It is source-copy evidence, not source code: preserved, never staged.
/recovered/

# Hermes Kanban isolated worktrees are local execution workspaces, not repo source.
.worktrees/
